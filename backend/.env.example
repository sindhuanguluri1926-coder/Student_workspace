# Port for backend server
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/student_assignment_workspace
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/student_assignment_workspace?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development
